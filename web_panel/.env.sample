# Auth del panel
PANEL_AUTH_TOKEN=test-token-123

# Dominio base para subdominios autogenerados
DEFAULT_BASE_DOMAIN=example.com
DEFAULT_ADMIN_PASS=cambia-este-password-fijo

# Prefijo de namespaces gestionados
NAMESPACE_PREFIX=drupal-
DRUPAL_APP_IMAGE=ghcr.io/tu-org/drupal-cms-app:2026-05-08.1
IMAGE_PULL_SECRET_NAME=ghcr-pull-secret
GHCR_REGISTRY=ghcr.io
GHCR_USERNAME=tu_usuario_github
GHCR_TOKEN=tu_token_read_packages
GHCR_EMAIL=tu_email@example.com

# SQLite local (ruta relativa portable; se crea respecto al directorio actual)
SQLITE_PATH=panel.test.db

# Dinahosting API (formato special/api.php)
DINAHOSTING_API_URL=https://dinahosting.com/special/api.php
DINAHOSTING_AUTH_USER=user_dn
DINAHOSTING_AUTH_PWD=password_dn
DINAHOSTING_DNS_TARGET=127.0.0.1
DINAHOSTING_DNS_TTL=300
